<?xml version="1.0" encoding="utf-8"?>
<!--
  Jauge de la vignette du sélecteur.

  Un aperçu de widget est inflaté sans qu'aucun code ne tourne : la jauge que
  dessine WidgetGauge au vol y laissait un trou. Un vectoriel comble le trou
  sans figer une image, et suit le thème clair/sombre par ses couleurs.

  Géométrie calquée sur la vraie : arc de 270° ouvert en bas, départ à 135°.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <path
        android:pathData="M21.72,78.28 A40,40 0 1 1 78.28,78.28"
        android:strokeColor="@color/widget_gauge_track"
        android:strokeWidth="11"
        android:strokeLineCap="round" />

    <path
        android:pathData="M21.72,78.28 A40,40 0 0 1 24.02,19.58"
        android:strokeColor="@color/widget_accent_production"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
</vector>
