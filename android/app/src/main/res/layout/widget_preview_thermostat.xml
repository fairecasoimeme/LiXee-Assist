<?xml version="1.0" encoding="utf-8"?>
<!-- Vignette du sélecteur pour le widget de thermostat.
     Le vrai layout ne convient pas : sa jauge est un bitmap dessiné au vol, et
     un aperçu n'exécute aucun code — elle y laisserait un trou. La jauge est
     donc vectorielle ici, et les valeurs sont un exemple figé. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_lixee_mark"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_logo_description" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Salon"
            android:maxLines="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_footer"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="2dp">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/preview_gauge_thermo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_thermo_gauge_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chaud · Auto · régule"
                android:maxLines="3"
                android:textSize="11sp"
                android:textColor="@color/widget_thermo_heat_on" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="2dp">

        <TextView
            android:layout_width="46dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="−"
            android:textSize="18sp"
            android:background="@drawable/widget_action_button"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="20,0 °C"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent" />

        <TextView
            android:layout_width="46dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="+"
            android:textSize="18sp"
            android:background="@drawable/widget_action_button"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="@string/widget_thermo_auto"
            android:textSize="11sp"
            android:background="@drawable/widget_action_button_on"
            android:textColor="@color/widget_on_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="@string/widget_thermo_on"
            android:textSize="11sp"
            android:background="@drawable/widget_action_button"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/widget_thermo_off"
            android:textSize="11sp"
            android:background="@drawable/widget_action_button"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="@string/widget_thermo_heat"
            android:textSize="11sp"
            android:background="@drawable/widget_action_button_heat"
            android:textColor="@color/widget_on_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="@string/widget_thermo_cool"
            android:textSize="11sp"
            android:background="@drawable/widget_action_button"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/widget_thermo_frost"
            android:textSize="11sp"
            android:background="@drawable/widget_action_button"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>
</LinearLayout>
