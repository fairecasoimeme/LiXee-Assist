<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget d'un groupe d'actions : le widget entier est le bouton.

  Pas de valeur à afficher, pas de grille à prévoir — juste l'icône choisie sur
  la box, le nom du groupe, et ce que le dernier déclenchement a donné.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Icône dessinée depuis le tracé que sert la box (firmware 2.23+). -->
    <ImageView
        android:id="@+id/group_icon_image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Émoji des firmwares antérieurs, écrit tel quel. -->
    <TextView
        android:id="@+id/group_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:text="" />

    <TextView
        android:id="@+id/group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:text="@string/widget_placeholder" />

    <TextView
        android:id="@+id/group_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="10sp"
        android:textColor="@color/widget_text_secondary"
        android:text="" />
</LinearLayout>
