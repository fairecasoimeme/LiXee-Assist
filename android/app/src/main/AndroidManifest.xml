<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.lixee.assist">

    <!-- Désactiver l'identifiant publicitaire (pas de pub dans l'app) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".AppContextProvider"
        android:label="LiXee-Assist"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/banner_tv"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 1er Intent : pour téléphones/tablettes -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 2e Intent : pour Android TV -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- lixee://pair?u=… : la page du QR code d'une TV propose d'y
                 envoyer une box enregistrée sur le téléphone. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lixee" android:host="pair" />
            </intent-filter>

            <!-- Les liens sont lus par app_links : sans cela, Flutter tenterait
                 aussi d'en faire une route, que l'app ne déclare pas. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
        </activity>

        <!-- Choix de la box, au dépôt du widget. Exportée car lancée par le
             lanceur : Android impose ce point d'entrée pour android:configure. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Écran de veille Android TV : énergie et thermostats en grand.
             Exporté et protégé par BIND_DREAM_SERVICE : seul le système peut
             le lancer. -->
        <service
            android:name=".LixeeDreamService"
            android:exported="true"
            android:label="@string/dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>

        <!-- Réveille un isolate Dart quand on appuie sur la jauge du widget,
             pour relever sans ouvrir l'app. Fourni par le plugin home_widget.
             Non exporté : il exécute les URI lixee:// qu'on lui passe, y
             compris des commandes d'appareil. Exporté, n'importe quelle app
             du téléphone pourrait piloter un volet sans confirmation. Nos
             PendingIntent portent notre identité et n'en ont pas besoin. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>

        <!-- Confirmation posée par-dessus le bureau. Thème dialogue et non
             exportée : elle n'est atteinte que par le PendingIntent du widget,
             qui porte déjà notre identité. -->
        <activity
            android:name=".WidgetLaunchConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.Alert" />

        <!-- Confirmation avant d'agir sur un appareil. Même parti pris que
             ci-dessus : refuser ne doit rien lancer ni rien envoyer. -->
        <activity
            android:name=".WidgetActionConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.Alert" />

        <!-- Exportée à dessein : c'est le lanceur, une autre application, qui
             démarre l'écran de configuration au dépôt du widget. Le thème
             dialogue est nécessaire aussi — sans lui, la barre d'action de
             l'app recouvre le titre et ampute la première ligne. -->
        <activity
            android:name=".DeviceWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".DeviceWidgetProvider"
            android:label="@string/widget_device_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_device_info" />
            <!-- Bureau HyperOS : relevé quand le widget apparaît à l'écran
                 (ExposureRefresh). Ignoré par les autres bureaux. -->
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="30000" />
        </receiver>

        <activity
            android:name=".WidgetGroupConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.Alert" />

        <!-- Exportée à dessein, comme les autres écrans de configuration :
             c'est le lanceur qui les démarre au dépôt du widget. -->
        <activity
            android:name=".ActionGroupWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ActionGroupWidgetProvider"
            android:label="@string/widget_group_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_group_info" />
        </receiver>

        <activity
            android:name=".ThermostatWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ThermostatWidgetProvider"
            android:label="@string/widget_thermo_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_thermostat_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="30000" />
        </receiver>

        <!-- Un receveur par thème : Android identifie un provider par son nom
             de composant, c'est ce qui leur donne des entrées distinctes dans
             le sélecteur. Tous partagent le même rendu et le même stockage.
             Les receveurs de widgets sont exportés pour que le bureau HyperOS
             puisse leur signaler l'apparition à l'écran (ExposureRefresh) ;
             leurs actions propres exigent le jeton de WidgetIntentGuard. -->
        <receiver
            android:name=".ConsoWidgetProvider"
            android:label="@string/widget_conso_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_conso_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="30000" />
        </receiver>

        <receiver
            android:name=".ProductionWidgetProvider"
            android:label="@string/widget_production_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_production_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="30000" />
        </receiver>

        <receiver
            android:name=".BalanceWidgetProvider"
            android:label="@string/widget_balance_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="30000" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Icône et couleur par défaut pour les notifications FCM -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Panneau mural : le kiosque se lance au démarrage, et revient au
             premier plan après un passage par l'écran du constructeur.
             Sans effet sur un téléphone ou une TV (voir PanelKiosk). -->
        <receiver
            android:name=".PanelBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".PanelReturnReceiver"
            android:exported="false" />
    </application>

    <!-- L'appareil photo ne sert qu'à scanner le QR code d'une TV : sans ces
         deux lignes, sa permission rendrait l'app introuvable sur les TV et
         les appareils sans caméra du Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Permissions Bluetooth traditionnelles -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- Permissions Android 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"  android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
